# Line endings: normalize text files to LF in the repo
* text=auto

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Unreal Engine assets
*.uasset filter=lfs diff=lfs merge=lfs -text
